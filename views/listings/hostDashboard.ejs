<% layout("/layouts/boilerplate") %>

<div class="container mt-4 mb-5">
    <h3 class="mb-4"><i class="fa-solid fa-chart-line bnb-color"></i> Host Dashboard</h3>

    <% if(reservations.length === 0) { %>
        <div class="alert alert-light border text-center py-5">
            <h4>No upcoming reservations.</h4>
            <p class="text-muted">Keep your listings updated to attract more guests!</p>
            <a href="/listings/new" class="btn btn-outline-dark mt-2">Create New Listing</a>
        </div>
    <% } else { %>

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            <% for(let res of reservations) { %>
                <div class="col">
                    <div class="card h-100 shadow-sm border-0">
                        <img src="<%= res.listing.image.url %>" class="card-img-top imgTrips" alt="Property Image" style="height: 200px; object-fit: cover;">
                        
                        <div class="card-body cardTrips">
                            <h5 class="card-title text-truncate"><%= res.listing.title %></h5>
                            
                            <hr>
                            
                            <p class="mb-1"><i class="fa-solid fa-user"></i> <strong>Guest:</strong> @<%= res.author.username %></p>
                            
                            <p class="mb-1"><i class="fa-solid fa-calendar-arrow-down"></i> <strong>Check-In:</strong> <%= res.checkIn.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></p>
                            <p class="mb-1"><i class="fa-solid fa-calendar-arrow-up"></i> <strong>Check-Out:</strong> <%= res.checkOut.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></p>
                            
                            <div class="mt-3 p-2 text-white rounded text-center tripsPaid">
                                <span class="fw-bold fs-5">Payout: &#x20B9;<%= res.totalPrice.toLocaleString("en-US") %></span>
                            </div>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>
    <% } %>
</div>