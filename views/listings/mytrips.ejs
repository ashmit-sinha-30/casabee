<% layout("/layouts/boilerplate") %>

<div class="container mt-4 mb-5">
    <h3 class="mb-4"><i class="fa-solid fa-plane-departure bnb-color"></i> My Trips</h3>

    <% if(trips.length === 0) { %>
        <div class="alert alert-light border text-center py-5">
            <h4>No trips booked... yet!</h4>
            <p class="text-muted">Time to dust off your bags and start planning your next adventure.</p>
            <a href="/listings" class="btn btn-outline-dark mt-2">Start Exploring</a>
        </div>
    <% } else { %>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            <% for(let trip of trips) { %>
                <div class="col">
                    <div class="card h-100 shadow-sm border-0">
                        <img src="<%= trip.listing.image.url %>" class="card-img-top imgTrips" alt="Property Image" style="height: 200px; object-fit: cover;">
                        
                        <div class="card-body cardTrips">
                            <h5 class="card-title"><%= trip.listing.title %></h5>
                            <p class="text-muted"><i class="fa-solid fa-location-dot bnb-color"></i> <%= trip.listing.location %>, <%= trip.listing.country %></p>
                            
                            <hr>
                            
                            <p class="mb-1"><strong>Check-In:</strong> <%= trip.checkIn.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></p>
                            <p class="mb-1"><strong>Check-Out:</strong> <%= trip.checkOut.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></p>
                            
                            <div class="mt-3 p-2 rounded text-center tripsPaid">
                                <span class="fw-bold fs-5">Total Paid: &#x20B9;<%= trip.totalPrice.toLocaleString("en-US") %></span>
                            </div>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>
    <% } %>
</div>